{
  // Aucun mot de passe ici : utiliser les variables d'environnement ALFRESCO_USERNAME / ALFRESCO_PASSWORD.
  "Alfresco": {
    "BaseUrl": "http://localhost:8080",
    "ParentNode": "-shared-",
    "RootFolder": "Capture",
    "CustomAspect": "",
    "CustomPrefix": "cap",
    "TimeoutSeconds": 100,
    "MaxRetries": 3
  },
  "Ocr": {
    // Windows : chemin complet de tesseract.exe si Tesseract n'est pas dans le PATH
    "TesseractPath": "tesseract",
    "Languages": "fra+eng"
  },
  "Capture": {
    "ClassificationThreshold": 0.6,
    "MoveFiles": true
  }
}
